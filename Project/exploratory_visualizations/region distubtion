import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

df = pd.read_csv("Cleaned_Data.csv")

df.groupby('region')['population'].sum().plot(
    kind='bar',
    figsize=(10, 5)
)
plt.title('Total Population by Region')
plt.xlabel('Region')
plt.ylabel('Population')
plt.tight_layout()
plt.show()
